{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HyperFont Control font profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "slots",
    "activation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "activation": {
      "const": "manual-reboot"
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chinese": {
          "$ref": "#/$defs/slot"
        },
        "latinSans": {
          "$ref": "#/$defs/slot"
        },
        "serif": {
          "$ref": "#/$defs/slot"
        },
        "monospace": {
          "$ref": "#/$defs/slot"
        }
      },
      "required": [
        "chinese",
        "latinSans",
        "serif",
        "monospace"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoFamilies": {
          "type": "boolean"
        },
        "engineCompatibility": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/coverageRule"
          }
        }
      }
    }
  },
  "$defs": {
    "assetId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "axisValues": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9 ]{4}$"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "weightMap": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "100",
          "200",
          "300",
          "400",
          "500",
          "600",
          "700",
          "800",
          "900"
        ]
      },
      "required": [
        "100",
        "200",
        "300",
        "400",
        "500",
        "600",
        "700",
        "800",
        "900"
      ],
      "additionalProperties": {
        "type": "number"
      }
    },
    "slot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "system"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "assetId",
            "familyMode"
          ],
          "properties": {
            "mode": {
              "const": "variable"
            },
            "assetId": {
              "$ref": "#/$defs/assetId"
            },
            "faceIndex": {
              "type": "integer",
              "minimum": 0
            },
            "familyMode": {
              "enum": [
                "continuous",
                "instances"
              ]
            },
            "axes": {
              "$ref": "#/$defs/axisValues"
            },
            "weightMap": {
              "$ref": "#/$defs/weightMap"
            },
            "italicAssetId": {
              "$ref": "#/$defs/assetId"
            },
            "italicFaceIndex": {
              "type": "integer",
              "minimum": 0
            },
            "fallbacks": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/fallbackSlot"
              }
            },
            "savedWeightMap": {
              "$ref": "#/$defs/weightMap"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "familyMode": {
                    "const": "instances"
                  }
                }
              },
              "then": {
                "required": [
                  "weightMap"
                ],
                "properties": {
                  "axes": {
                    "not": {
                      "required": [
                        "wght"
                      ]
                    }
                  }
                }
              },
              "else": {
                "not": {
                  "required": [
                    "weightMap"
                  ]
                },
                "properties": {
                  "axes": {
                    "not": {
                      "required": [
                        "wght"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "faces",
            "missingWeightPolicy"
          ],
          "properties": {
            "mode": {
              "const": "static"
            },
            "missingWeightPolicy": {
              "enum": [
                "reject",
                "nearest"
              ]
            },
            "faces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 18,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "weight",
                  "style",
                  "assetId",
                  "faceIndex"
                ],
                "properties": {
                  "weight": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900,
                    "multipleOf": 100
                  },
                  "style": {
                    "enum": [
                      "normal",
                      "italic"
                    ]
                  },
                  "assetId": {
                    "$ref": "#/$defs/assetId"
                  },
                  "faceIndex": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "fallbacks": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/fallbackSlot"
              }
            }
          }
        }
      ]
    },
    "coverageRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "font"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_. -]+$"
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "role": {
          "enum": [
            "sans",
            "serif",
            "monospace",
            "casual",
            "cursive",
            "decorative",
            "emoji",
            "symbols",
            "icons"
          ]
        },
        "scripts": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{4}$"
          }
        },
        "languages": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          }
        },
        "families": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "font": {
          "$ref": "#/$defs/slot"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "emoji",
                  "symbols",
                  "icons"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "scripts": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "required": [
              "scripts"
            ],
            "properties": {
              "scripts": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "icons"
              }
            }
          },
          "then": {
            "required": [
              "families"
            ],
            "properties": {
              "families": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "scripts"
            ],
            "properties": {
              "scripts": {
                "contains": {
                  "const": "Hani"
                }
              }
            }
          },
          "then": {
            "required": [
              "languages"
            ],
            "properties": {
              "languages": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "fallbackSlot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "assetId",
            "familyMode"
          ],
          "properties": {
            "mode": {
              "const": "variable"
            },
            "assetId": {
              "$ref": "#/$defs/assetId"
            },
            "faceIndex": {
              "type": "integer",
              "minimum": 0
            },
            "familyMode": {
              "enum": [
                "continuous",
                "instances"
              ]
            },
            "axes": {
              "$ref": "#/$defs/axisValues"
            },
            "weightMap": {
              "$ref": "#/$defs/weightMap"
            },
            "italicAssetId": {
              "$ref": "#/$defs/assetId"
            },
            "italicFaceIndex": {
              "type": "integer",
              "minimum": 0
            },
            "savedWeightMap": {
              "$ref": "#/$defs/weightMap"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "familyMode": {
                    "const": "instances"
                  }
                }
              },
              "then": {
                "required": [
                  "weightMap"
                ],
                "properties": {
                  "axes": {
                    "not": {
                      "required": [
                        "wght"
                      ]
                    }
                  }
                }
              },
              "else": {
                "not": {
                  "required": [
                    "weightMap"
                  ]
                },
                "properties": {
                  "axes": {
                    "not": {
                      "required": [
                        "wght"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "faces",
            "missingWeightPolicy"
          ],
          "properties": {
            "mode": {
              "const": "static"
            },
            "missingWeightPolicy": {
              "enum": [
                "reject",
                "nearest"
              ]
            },
            "faces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 18,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "weight",
                  "style",
                  "assetId",
                  "faceIndex"
                ],
                "properties": {
                  "weight": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900,
                    "multipleOf": 100
                  },
                  "style": {
                    "enum": [
                      "normal",
                      "italic"
                    ]
                  },
                  "assetId": {
                    "$ref": "#/$defs/assetId"
                  },
                  "faceIndex": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
